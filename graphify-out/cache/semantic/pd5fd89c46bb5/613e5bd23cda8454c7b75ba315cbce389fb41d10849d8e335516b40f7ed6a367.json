{"nodes": [{"id": "skills_expo_skills_plugins_expo_skills_expo_native_ui_skill", "label": "Expo Native UI Skill", "file_type": "document", "source_file": "skills/expo-skills/plugins/expo/skills/expo-native-ui/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_native_ui_skill_expogo_first_strategy", "label": "Expo Go First Strategy", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-native-ui/SKILL.md", "source_location": "lines 32-58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most Expo apps work in Expo Go without custom native code; custom builds add complexity, slower iteration, and require Xcode/Android Studio setup. Custom builds are only required for local Expo modules, Apple targets (@bacons/apple-targets), third-party native modules missing from Expo Go, or native configuration not expressible in app.json."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_native_ui_skill_color_api_semantic_colors", "label": "Color API Semantic Colors", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-native-ui/SKILL.md", "source_location": "lines 119-169", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use the type-safe Color wrapper from expo-router over raw PlatformColor: exposes iOS UIKit colors (Color.ios.*) and Android Material 3 colors (Color.android.material.* static, Color.android.dynamic.* wallpaper-adaptive on Android 12+). Resolves on-device and auto-adapts to light/dark mode and accessibility settings, eliminating separate light/dark hex tables and colors.web.ts. Wrap values in Platform.select with hex default for web; never pass Color/PlatformColor into Reanimated styles; cast to string for third-party props that reject OpaqueColorValue."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_native_ui_skill_theme_colors_palette", "label": "theme/colors.ts Centralized Palette", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-native-ui/SKILL.md", "source_location": "lines 123-165", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_native_ui_skill_component_selection_rule", "label": "Consult @expo/ui Before Built-ins Rule", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-native-ui/SKILL.md", "source_location": "lines 70, 12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@expo/ui renders real SwiftUI/Jetpack Compose and works in Expo Go on SDK 56+, giving best platform fit for sheets, pickers, sliders, toggles, menus, grouped forms. Exception: @expo/ui List is native grouped rows, not virtualized - use FlatList/FlashList for large datasets."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_native_ui_skill_content_inset_adjustment_behavior", "label": "contentInsetAdjustmentBehavior Automatic Responsiveness", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-native-ui/SKILL.md", "source_location": "lines 86-97, 110, 116", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_native_ui_skill_expo_image_sf_source", "label": "expo-image SF Symbol Source Guidance", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-native-ui/SKILL.md", "source_location": "line 75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Library preference: use expo-image with source='sf:name' for SF Symbols, not expo-symbols or @expo/vector-icons."}], "edges": [{"source": "skills_expo_skills_plugins_expo_skills_expo_native_ui_skill", "target": "skills_expo_skills_plugins_expo_skills_e