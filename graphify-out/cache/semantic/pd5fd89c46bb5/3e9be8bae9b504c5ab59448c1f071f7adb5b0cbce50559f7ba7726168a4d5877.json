{"nodes": [{"id": "skills_skills_engineering_diagnosing_bugs_skill", "label": "Diagnosing Bugs Skill", "file_type": "document", "source_file": "skills/skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_engineering_diagnosing_bugs_skill_feedback_loop", "label": "Feedback Loop", "file_type": "concept", "source_file": "skills/skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase 1 is the skill itself: with a tight red-capable pass/fail signal the cause will be found. Without one, no code reading helps. A 30-second flaky loop is barely better than none; a 2-second deterministic one is a debugging superpower."}, {"id": "skills_skills_engineering_diagnosing_bugs_skill_minimise_repro", "label": "Minimise Repro", "file_type": "rationale", "source_file": "skills/skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shrink the repro to the smallest scenario that still goes red, one cut at a time, until every remaining element is load-bearing \u2014 it shrinks the hypothesis space and becomes the clean regression test."}, {"id": "skills_skills_engineering_diagnosing_bugs_skill_ranked_hypotheses", "label": "Ranked Falsifiable Hypotheses", "file_type": "rationale", "source_file": "skills/skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generate 3-5 ranked falsifiable hypotheses before testing any, each stating a prediction; single-hypothesis generation anchors on the first plausible idea."}, {"id": "skills_skills_engineering_diagnosing_bugs_skill_tagged_instrumentation", "label": "Tagged Instrumentation", "file_type": "rationale", "source_file": "skills/skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tag every debug log with a unique prefix like [DEBUG-a4f2] so cleanup is a single grep; one breakpoint beats ten logs; never 'log everything and grep'."}, {"id": "skills_skills_engineering_diagnosing_bugs_skill_perf_branch", "label": "Perf Branch (Measure First)", "file_type": "rationale", "source_file": "skills/skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For performance regressions logs are usually wrong \u2014 establish a baseline measurement first (timing harness, profiler, query plan), then bisect. Measure first, fix second."}, {"id": "skills_skills_engineering_diagnosing_bugs_skill_correct_seam", "label": "Correct Seam", "file_type": "concept", "source_file": "skills/skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A regression test is only worth writing where a seam exists that exercises the real bug pattern as it occurs at the call site; if no correct seam exists, that itself is the finding \u2014 the architecture is preventing the bug from being locked down."}, {"id": "skills_skills_engineering_diagnosing_bugs_skill_regression_test", "label": "Regression Test", "file_type": "concept", "source_file": "skills/skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_engineering_diagnosing_bugs_skill_post_mortem", "label": "Post-mortem", "file_type": "concept", "source_file": "skills/skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After the fix is in, ask what would have prevented the bug; if the answer involves architectural change, hand off to improve-codebase-architecture with the specifics."}, {"id": "skills_skills_engineering_diagnosing_bugs_skill_hitl_loop_template", "label": "HITL Loop Template Script", "file_type": "concept", "source_file": "skills/skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Last-resort loop: if a human must click, drive them with scripts/hitl-loop.template.sh so the loop stays structured and captured output feeds back to the agent."}], "edges": [{"source": "skills_skills_engineering_diagnosing_bugs_skill", "target": "skills_skills_engineering_diagnosing_bugs_skill_feedback_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_engineering_diagnosing_bugs_skill", "target": "skills_skills_engineering_diagnosing_bugs_skill_minimise_repro", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_engineering_diagnosing_bugs_skill", "target": "skills_skills_engineering_diagnosing_bugs_skill_ranked_hypotheses", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_engineering_diagnosing_bugs_skill", "target": "skills_skills_engineering_diagnosing_bugs_skill_tagged_instrumentation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/ski