{"nodes": [{"id": "skills_skills_engineering_prototype_ui", "label": "UI Prototype Guide", "file_type": "document", "source_file": "skills/skills/skills/engineering/prototype/UI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_engineering_prototype_ui_radical_variants", "label": "Radical Variant Generation", "file_type": "concept", "source_file": "skills/skills/skills/engineering/prototype/UI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 3 variants, cap at 5. Variants must be structurally different \u2014 different layout, information hierarchy, primary affordance \u2014 not just colour/copy tweaks, or the prototype is wallpaper."}, {"id": "skills_skills_engineering_prototype_ui_variant_switcher", "label": "Floating Variant Switcher", "file_type": "concept", "source_file": "skills/skills/skills/engineering/prototype/UI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed bottom-centre bar with left/right arrows and a variant label; updates the ?variant= URL param so the choice is shareable and reload-stable. Gated off in production builds."}, {"id": "skills_skills_engineering_prototype_ui_subshape_a", "label": "Sub-shape A: Variants on Existing Page", "file_type": "concept", "source_file": "skills/skills/skills/engineering/prototype/UI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preferred \u2014 variants render on an existing route gated by ?variant=, so real header/sidebar/data/density context makes each variant judgeable; only the rendered subtree swaps."}, {"id": "skills_skills_engineering_prototype_ui_subshape_b", "label": "Sub-shape B: Throwaway Route", "file_type": "concept", "source_file": "skills/skills/skills/engineering/prototype/UI.md", "sour