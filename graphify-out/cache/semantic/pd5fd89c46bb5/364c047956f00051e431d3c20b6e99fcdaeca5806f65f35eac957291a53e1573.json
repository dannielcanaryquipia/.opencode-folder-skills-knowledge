{"nodes": [{"id": "skills_expo_skills_plugins_expo_skills_expo_examples_skill_examples_repo", "label": "expo/examples Repository", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-examples/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "~70 with-* integration examples, each built around one library/service. Managed projects (no ios/android dirs), typically a single screen of ~100-200 lines. Mine them for the canonical integration pattern (dependency set, app.json config plugins, minimal wiring against current SDK), not application architecture. Default branch is master."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_examples_skill_inspiration_adapt_mode", "label": "Inspiration Mode (Adapt the Pattern)", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-examples/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never scaffold an example on top of the user's project. Version-align dependencies with npx expo install instead of copying pins because examples track the latest SDK; merge config rather than replacing it; pull whole examples into a throwaway/gitignored dir for reading, never into the user's project."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_examples_skill_scaffold_mode", "label": "Scaffold Mode (create-expo --example)", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-examples/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_examples_skill_meta_json_aliases_deprecations", "label": "meta.json Aliases & Deprecations", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-examples/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_examples_skill_version_aligned_dependency_adoption", "label": "Version-Aligned Dependency Adoption", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-examples/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Example package.json pins track the latest SDK and won't match older projects; add only the missing deps via npx expo install, which resolves SDK-correct versions."}], "edges": [{"source": "skills_expo_skills_plugins_expo_skills_expo_examples_skill_inspiration_adapt_mode", "target": "skills_expo_skills_plugins_expo_skills_expo_examples_skill_examples_repo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-examples/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_examples_skill_scaffold_mode", "target": "skills_expo_skills_plugins_expo_skills_expo_examples_skill_examples_repo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-examples/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_examples_skill_meta_json_aliases_deprecations", "target": "skills_expo_skills_plugins_expo_skills_expo_examples_skill_examples_repo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-examples/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_examples_skill_inspiration_adapt_mode", "target": "skills_expo_skills_plugins_expo_skills_expo_examples_skill_meta_json_aliases_deprecations", "relation": "references", "confidence": "EXT