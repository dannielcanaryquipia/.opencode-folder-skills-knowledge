e_plugin_bucketed_layout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "skills_distribution_channels", "label": "Skills Distribution Channels (Claude plugin, Codex plugin, skills.sh)", "nodes": ["skills_agents_adr_0002_ship_as_a_claude_code_plugin_claude_code_plugin", "skills_agents_adr_0002_ship_as_a_claude_code_plugin_codex_plugin", "skills_agents_adr_0002_ship_as_a_claude_code_plugin_skills_sh"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "skills/skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md"}]}