{"nodes": [{"id": "skills_agents_adr_0002_ship_as_a_claude_code_plugin_adr", "label": "ADR 0002: Ship the skill set as a native Claude Code plugin; defer a native Codex plugin", "file_type": "document", "source_file": "skills/skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_agents_adr_0002_ship_as_a_claude_code_plugin_bucketed_layout", "label": "Bucketed Skills Layout", "file_type": "concept", "source_file": "skills/skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skills live in bucket folders under skills/ \u2014 engineering/ and productivity/ are promoted (shipped); misc/, personal/, in-progress/, and deprecated/ are not. A plugin must expose only the promoted set, which spans two buckets, and the manifest formats do not cleanly express a curated subset of a bucketed repo \u2014 the original, half-remembered reason a plugin was not shipped earlier."}, {"id": "skills_agents_adr_0002_ship_as_a_claude_code_plugin_claude_code_plugin", "label": "Native Claude Code Plugin", "file_type": "concept", "source_file": "skills/skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claude Code plugin.json accepts skills as an array of explicit skill-directory paths, so promoted skills are listed one by one with zero ambiguity; a sibling marketplace.json makes the repo its own single-plugin marketplace. Verified with `claude plugin validate . --strict`."}, {"id": "skills_agents_adr_0002_ship_as_a_claude_code_plugin_codex_plugin", "label": "Native Codex Plugin (deferred)", "file_type": "concept", "source_file": "skills/skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Codex plugin.json accepts skills only as a single path string and drops symlinks on install, so neither pointing at ./skills/ nor a symlink dir survives; the robust options (restructuring skills/ to promoted-only or committing duplicate copies) are structural decisions deferred until Codex supports a skills array or preserves symlinks."}, {"id": "skills_agents_adr_0002_ship_as_a_claude_code_plugin_skills_sh", "label": "skills.sh Universal Installer", "file_type": "concept", "source_file": "skills/skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep skills.sh as the universal installer since it already serves Codex and other harnesses today, so no Codex user is left without an install path while the native Codex plugin is deferred."}, {"id": "skills_agents_adr_0002_ship_as_a_claude_code_plugin_promoted_buckets", "label": "Promoted Buckets (engineering/, productivity/)", "file_type": "concept", "source_file": "skills/skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "skills_agents_adr_0002_ship_as_a_claude_code_plugin_adr", "target": "skills_agents_adr_0002_ship_as_a_claude_code_plugin_claude_code_plugin", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "source_location": null, "weight": 1.0}, {"source": "skills_agents_adr_0002_ship_as_a_claude_code_plugin_adr", "target": "skills_agents_adr_0002_ship_as_a_claude_code_plugin_codex_plugin", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "sou