{"nodes": [{"id": "docs_engineering_prototype_prototype", "label": "prototype (throwaway design answerer)", "file_type": "document", "source_file": "skills/skills/docs/engineering/prototype.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds a small disposable program whose only job is to answer one design question. Throwaway from day one - no tests, no error handling beyond what makes it run, no persistence."}, {"id": "docs_engineering_prototype_two_branches", "label": "Two prototype branches", "file_type": "concept", "source_file": "skills/skills/docs/engineering/prototype.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "State/logic questions get a tiny interactive terminal app printing full state after every action; UI questions get several radically different variations on one route. Picking the wrong branch wastes the whole prototype, so the question comes first."}, {"id": "docs_engineering_prototype_primary_source", "label": "Prototype as primary source", "file_type": "rationale", "source_file": "skills/skills/docs/engineering/prototype.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The prototype itself is the runnable evidence the answer came from. Once the answer is captured, fold validated decisions into real code, capture the prototype on a throwaway branch - out of main, never merged - with a context pointer on the implementation issue."}], "edges": [{"source": "docs_engineering_prototype_prototype", "target": "docs_engineering_prototype_two_branches", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/prototype.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_prototype_prototype", "target": "docs_engineering_prototype_primary_source", 