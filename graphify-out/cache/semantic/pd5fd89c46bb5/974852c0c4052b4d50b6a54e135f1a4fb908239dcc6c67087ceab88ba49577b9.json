{"nodes": [{"id": "docs_engineering_tdd_tdd", "label": "tdd (red-green loop)", "file_type": "document", "source_file": "skills/skills/docs/engineering/tdd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds a feature or fixes a bug test-first, one behaviour at a time. Will not write all tests up front - horizontal slicing produces tests of imagined behaviour."}, {"id": "docs_engineering_tdd_red_green_loop", "label": "Red-green loop", "file_type": "rationale", "source_file": "skills/skills/docs/engineering/tdd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Write one failing test (red), add just enough code to pass it (green), repeat - each cycle informed by what the last one taught. Refactor only once the suite is green, never while red."}, {"id": "docs_engineering_tdd_vertical_slices", "label": "Vertical slices", "file_type": "rationale", "source_file": "skills/skills/docs/engineering/tdd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One test, then just enough code to pass it, then the next test. Tests target public interfaces only so the implementation can change without the tests moving."}, {"id": "docs_engineering_tdd_tracer_bullet", "label": "Tracer bullet", "file_type": "rationale", "source_file": "skills/skills/docs/engineering/tdd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The first cycle proves a single path works end-to-end before building outward - you never outrun your headlights by committing to test structure you don't yet understand."}, {"id": "docs_engineering_tdd_tautological_test", "label": "Tautological tests", "file_type": "rationale", "source_file": "skills/skills/docs/engineering/tdd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A test whose assertion is recomputed the way the code computes it passes by construction and gives zero confidence. Expected values must come from an independent source of truth - a known-good literal, a worked example, the spec."}], "edges": [{"source": "docs_engineering_tdd_tdd", "target": "docs_engineering_tdd_red_green_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/tdd.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_tdd_tdd", "target": "docs_engineering_tdd_vertical_slices", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/tdd.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_tdd_tdd", "target": "docs_engineering_tdd_tracer_bullet", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/tdd.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_tdd_tdd", "target": "docs_engineering_tdd_tautological_test", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/tdd.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_tdd_tdd", "target": "readme_to_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/tdd.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_tdd_tdd", "target": "docs_engineering_codebase_design_codebase_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/tdd.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_tdd_tdd", "target": "docs_engineering_implement_implement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/tdd.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_tdd_tdd", "target": "docs_engineering_code_review_code_review", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/tdd.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_tdd_tdd", "target": "docs_engineering_ask_matt_ask_matt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/tdd.md", "source_location": null, "weight": 1.0}], "hyperedges": []}