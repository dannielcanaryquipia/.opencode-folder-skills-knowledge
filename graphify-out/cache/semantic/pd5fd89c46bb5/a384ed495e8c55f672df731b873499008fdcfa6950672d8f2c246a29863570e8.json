{"nodes": [{"id": "skills_agents_writing_docs_doc", "label": "Writing Docs Pages", "file_type": "document", "source_file": "skills/skills/.agents/writing-docs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_agents_writing_docs_docs_page", "label": "Docs Page (aihero.dev distributed router node)", "file_type": "concept", "source_file": "skills/skills/.agents/writing-docs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most promoted skills are user-invoked, so the human is the index that must remember they exist \u2014 that memory is cognitive load. The job of a docs page is to relieve it: orient one reader around one skill so they can hold it in their head. The pages are collectively a distributed router; each is a node, and every link is absolute because the pages publish on aihero.dev."}, {"id": "skills_agents_writing_docs_defining_constraint", "label": "Defining Constraint", "file_type": "concept", "source_file": "skills/skills/.agents/writing-docs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single fact that makes a skill behave differently from the obvious default (e.g. to-spec does not interview the user again); state it as plain declarative prose, never a labelled aside \u2014 it is the most valuable line on the page and must never be omitted."}, {"id": "skills_agents_writing_docs_leading_word", "label": "Leading Word", "file_type": "concept", "source_file": "skills/skills/.agents/writing-docs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Surface the skill's leading word / defining idea (tight feedback loop, deep module, red-green) so the reader learns what the skill is and the word they will later think with to reach for it."}], "edges": [{"source": "skills_agents_writing_docs_doc", "target": "skills_agents_writing_docs_docs_page", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/.agents/writing-docs.md", "source_location": null, "weight": 1.0}, {"source": "skills_agents_writing_docs_doc", "target": "skills_agents_writing_docs_defining_constraint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/.agents/writing-docs.md", "source_location": null, "weight": 1.0}, {"source": "skills_agents_writing_docs_doc", "target": "skills_agents_writing_docs_leading_word", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/.agents/writing-docs.md", "source_location": null, "weight": 1.0}, {"source": "skills_agents_writing_docs_docs_page", "target": "skills_skills_skills_engineering_ask_matt_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/.agents/writing-docs.md", "source_location": null, "weight": 1.0}, {"source": "skills_agents_writing_docs_docs_page", "target": "skills_agents_invocation_user_invoked", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/.agents/writing-docs.md", "source_location": null, "weight": 1.0}], "hyperedges": []}