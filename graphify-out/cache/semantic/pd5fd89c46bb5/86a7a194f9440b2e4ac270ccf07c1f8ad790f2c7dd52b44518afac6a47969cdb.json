{"nodes": [{"id": "skills_agents_adr_0001_explicit_setup_pointer_only_for_hard_dependencies_adr", "label": "ADR 0001: Explicit /setup-matt-pocock-skills pointer only for hard dependencies", "file_type": "document", "source_file": "skills/skills/.agents/adr/0001-explicit-setup-pointer-only-for-hard-dependencies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_agents_adr_0001_explicit_setup_pointer_only_for_hard_dependencies_hard_dependency", "label": "Hard-Dependency Skills", "file_type": "concept", "source_file": "skills/skills/.agents/adr/0001-explicit-setup-pointer-only-for-hard-dependencies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skills like to-tickets, to-spec, triage cannot meaningfully function without the per-repo config seeded by setup-matt-pocock-skills (issue tracker, triage label vocabulary, domain doc layout) \u2014 without the mapping, output is wrong, not just fuzzy, so they carry an explicit one-liner pointing at /setup-matt-pocock-skills."}, {"id": "skills_agents_adr_0001_explicit_setup_pointer_only_for_hard_dependencies_soft_dependency", "label": "Soft-Dependency Skills", "file_type": "concept", "source_file": "skills/skills/.agents/adr/0001-explicit-setup-pointer-only-for-hard-dependencies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skills like diagnose, tdd, improve-codebase-architecture only use the config to sharpen output and degrade gracefully without it, so they reference the domain glossary and ADRs in vague prose only \u2014 keeping them token-light and avoiding cargo-culting the setup pointer where it is not load-bearing."}, {"id": "skills_skills_skills_engineering_setup_matt_pocock_skills_skill", "label": "setup-matt-pocock-skills", "file_type": "concept", "source_file": "skills/skills/.agents/adr/0001-expli