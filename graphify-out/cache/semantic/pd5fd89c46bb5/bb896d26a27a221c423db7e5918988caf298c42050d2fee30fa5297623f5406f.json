{"nodes": [{"id": "skills_expo_skills_plugins_expo_skills_expo_animation_skill", "label": "Expo Animation", "file_type": "document", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_skill_two_runtimes_model", "label": "Two Runtimes model (RN + UI thread)", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An animation touching the RN runtime stutters when the app is busy; the whole craft is keeping motion on the UI runtime where worklets run every frame."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_skill_frequency_gate", "label": "Animation Frequency Gate", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frequency tier decides whether to animate at all; high-frequency interactions get platform default or nothing, rare moments hold the delight budget. The gate exists to produce zero lines of code sometimes."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_skill_schedule_on_rn", "label": "scheduleOnRN", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reanimated 4 replacement for deprecated runOnJS; belongs in onEnd or a threshold useAnimatedReaction, never per frame in onUpdate or scroll handlers."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_skill_spring_configs", "label": "Reanimated spring parameter table", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Springs carry velocity through interruptions while timing curves restart; bounce is reserved for gestures that carried momentum."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_skill_haptics_rules", "label": "Haptics usage rules", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fire in the same frame as the visual at the causal moment, one per user action, never the only feedback since haptics can be off system-wide or silent on Android hardware."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_skill_gesture_handler_root_view", "label": "GestureHandlerRootView requirement", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it gestures do nothing with no error; must wrap the app once at the root layout."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_skill_cadisable_minimum_frame_duration", "label": "CADisableMinimumFrameDurationOnPhone (120fps)", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Third-party animations cap at 60fps on ProMotion iPhones without this key; enabling it makes the frame budget 8ms instead of 16ms."}], "edges": [{"source": "skills_expo_skills_plugins_expo_skills_expo_animation_skill", "target": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_animation_skill_two_runtimes_model", "target": "skills_expo_skills_plugins_expo_skills_expo_animation_skill", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_animation_skill_frequency_gate", "target": "skills_expo_skills_plugins_expo_skills_expo_animation_skill", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_animation_skill_haptics_rules", "target": "skills_expo_skills_plugins_expo_skills_expo_animation_skill", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_animation_skill", "target": "skills_expo_skills_plugins_expo_skills_expo_animation_skill_spring_configs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_animation_skill", "target": "skills_expo_skills_plugins_expo_skills_expo_animation_skill_schedule_on_rn", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/SKILL.md", "source_loc