{"nodes": [{"id": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes", "label": "Expo Animation Recipes", "file_type": "document", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes_project", "label": "project() momentum projection worklet", "file_type": "code", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decides where a flick was going using Apple's exponential-decay form, so a fast short swipe commits and a slow long one does not."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes_rubberband", "label": "rubberband() overscroll worklet", "file_type": "code", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes a boundary resist progressively instead of stopping dead."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes_pressable_scale", "label": "PressableScale component", "file_type": "code", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes_drag_dismiss_sheet", "label": "Drag-to-dismiss bottom sheet recipe", "file_type": "code", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Velocity decides dismissal, not distance; onStart captures current value so mid-animation grabs continue smoothly; overshootClamping prevents a gap flash on dismissal."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes_swipe_to_delete", "label": "Swipe-to-delete row recipe", "file_type": "code", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Declaring the pan axis via activeOffsetX stops the gesture from stealing vertical scrolls inside a list."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes_collapsing_header", "label": "Collapsing header recipe", "file_type": "code", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never animate header height (layout pass competes with scroll); translate clipped content instead, and Extrapolation.CLAMP prevents inverted reappearing headers."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes_list_entrances", "label": "List entrances recipe", "file_type": "code", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "entering on virtualized-list rows re-fires on row recycling; animate the container once or use itemLayoutAnimation for reflow."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes_keyboard_synced_ui", "label": "Keyboard-synced UI recipe", "file_type": "code", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The keyboard rides a private system curve arriving late on the JS thread; the UI must be driven by the keyboard's actual position frame-by-frame, never Keyboard.addListener plus a timing animation."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes_tab_indicator", "label": "Tab / segmented indicator recipe", "file_type": "code", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sanctioned width animation: absolutely positioned childless pill re-lays-out nothing and preserves corner radius that scaleX would smear."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes_screen_transitions", "label": "Screen transitions recipe (Expo Router)", "file_type": "code", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native stack transitions keep the interactive back gesture and match platform conventions; animationMatchesGesture runs the custom transition in reverse under the finger."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes_threshold_reaction", "label": "Threshold-crossing reaction pattern", "file_type": "code", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comparison runs on the UI thread every frame while the JS callback fires only twice per crossing, avoiding per-frame RN scheduling."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes_react_native_keyboard_controller", "label": "react-native-keyboard-controller", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needs KeyboardProvider at the root or its hooks do nothing; exposes keyboard height as a shared value on the UI thread."}], "edges": [{"source": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes", "target": "skills_expo_skills_plugins_expo_skills_expo_animation_skill_frequency_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes", "target": "skills_expo_skills_plugins_expo_skills_expo_animation_skill_two_runtimes_model", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes", "target": "skills_expo_skills_plugins_expo_skills_expo_animation_skill_gesture_handler_root_view", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes_drag_dismiss_sheet", "target": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes_project", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes_drag_dismiss_sheet", "target": "skills_expo_skills_plugins_expo_skills_expo_animation_recipes_rubberband", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-animation/RECIPES.md", "source_location": null, "weight": 1.0}, {"