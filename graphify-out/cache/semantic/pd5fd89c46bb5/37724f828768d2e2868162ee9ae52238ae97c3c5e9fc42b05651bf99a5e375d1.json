{"nodes": [{"id": "docs_engineering_diagnosing_bugs_diagnosing_bugs", "label": "diagnosing-bugs (diagnosis loop)", "file_type": "document", "source_file": "skills/skills/docs/engineering/diagnosing-bugs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Disciplined loop for hard bugs and performance regressions: reproduce, minimise, rank hypotheses, instrument, fix with a regression test. Refuses to hypothesise before a tight feedback loop exists."}, {"id": "docs_engineering_diagnosing_bugs_tight_feedback_loop", "label": "Tight feedback loop", "file_type": "rationale", "source_file": "skills/skills/docs/engineering/diagnosing-bugs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One runnable command that goes red on this bug. No red-capable loop, no diagnosis. 30-second flaky loop is barely better than none; a 2-second deterministic one is a debugging superpower. For non-deterministic bugs the goal is a higher reproduction rate: loop, parallelise, add stress."}, {"id": "docs_engineering_diagnosing_bugs_repro_ladder", "label": "Repro ladder", "file_type": "rationale", "source_file": "skills/skills/docs/engineering/diagnosing-bugs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A ladder of ways to build the loop - failing test, curl script, CLI diff, headless browser, replayed trace, throwaway harness, fuzz loop, git bisect run, differential run - and only as a last resort a human-in-the-loop bash script."}], "edges": [{"source": "docs_engineering_diagnosing_bugs_diagnosing_bugs", "target": "docs_engineering_diagnosing_bugs_tight_feedback_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/diagnosing-bugs.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_diagnosing_bugs_diagnosing_bugs", "target": "docs_engineering_diagnosing_bugs_repro_ladder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/diagnosing-bugs.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_diagnosing_bugs_diagnosing_bugs", "target": "docs_engineering_prototype_prototype", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/diagnosing-bugs.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_diagnosing_bugs_diagnosing_bugs", "target": "docs_engineering_improve_codebase_architecture_improve_codebase_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/diagnosing-bugs.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_diagnosing_bugs_diagnosing_bugs", "target": "docs_engineering_ask_matt_ask_matt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/diagnosing-bugs.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_diagnosing_bugs_tight_feedback_loop", "target": "readme_pragmatic_programmer", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "skills/skills/docs/engineering/diagnosing-bugs.md", "source_location": null, "weight": 1.0}], "hyperedges": []}