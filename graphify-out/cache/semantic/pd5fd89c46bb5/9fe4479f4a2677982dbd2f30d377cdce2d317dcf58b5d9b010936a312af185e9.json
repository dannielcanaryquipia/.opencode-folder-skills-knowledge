{"nodes": [{"id": "skills_expo_skills_plugins_expo_skills_expo_dom_skill_dom_components", "label": "Expo DOM Components", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-dom/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run web code verbatim in a webview on native and as-is on web. Use for web-only libraries (recharts, chart.js, syntax highlighters), migrated web code, complex HTML/CSS layouts, iframes/embeds, canvas/WebGL. Avoid when native performance is critical (webviews add overhead), for simple UI, deep native integration, or layout routes (_layout cannot be DOM components). Webviews have their own isolated JS context."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_dom_skill_use_dom_directive", "label": "'use dom' Directive", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-dom/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_dom_skill_dom_prop", "label": "DOM Props", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-dom/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_dom_skill_native_action_props", "label": "Native Actions via Async Props", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-dom/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pass async functions as props to expose native functionality across the webview boundary safely; props must be serializable (strings, numbers, booleans, arrays, plain objects)."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_dom_skill_router_api_prop_limitation", "label": "Router APIs Requiring Props", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-dom/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useLocalSearchParams/useGlobalSearchParams/usePathname/useSegments/useRootNavigation/useRootNavigationState need synchronous access to native routing state unavailable inside the isolated webview context; solution is reading them in the native parent and passing values as props."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_dom_skill_is_dom_detection", "label": "IS_DOM Environment Detection", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-dom/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "skills_expo_skills_plugins_expo_skills_expo_dom_skill_use_dom_directive", "target": "skills_expo_skills_plugins_expo_skills_expo_dom_skill_dom_components", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-dom/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_dom_skill_dom_prop", "target": "skills_expo_skills_plugins_expo_skills_expo_dom_skill_dom_components", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-dom/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_dom_skill_native_action_props", "target": "skills_expo_skills_plugins_expo_skills_expo_dom_skill_dom_components", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-dom/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_d