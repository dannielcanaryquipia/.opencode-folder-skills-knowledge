{"nodes": [{"id": "skills_skills_misc_setup_pre_commit_skill", "label": "Setup Pre-Commit", "file_type": "document", "source_file": "skills/skills/skills/misc/setup-pre-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_misc_setup_pre_commit_husky", "label": "Husky Pre-Commit Hook", "file_type": "concept", "source_file": "skills/skills/skills/misc/setup-pre-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Husky v9+ hook files need no shebang; the pre-commit hook runs lint-staged first (fast, staged-only), then full typecheck and tests, and omits typecheck/test lines when the repo has no such scripts."}, {"id": "skills_skills_misc_setup_pre_commit_lint_staged", "label": "lint-staged + Prettier", "file_type": "concept", "source_file": "skills/skills/skills/misc/setup-pre-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lint-staged runs Prettier only on staged files (fast) with --ignore-unknown to skip files Prettier cannot parse (images, etc.); Prettier config is created only if missing; the first commit doubles as the smoke test."}, {"id": "skills_skills_misc_setup_pre_commit_package_manager_detection", "label": "Package Manager Detection", "file_type": "concept", "source_file": "skills/skills/skills/misc/setup-pre-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detects npm/pnpm/yarn/bun from lockfiles (package-lock.json, pnpm-lock.yaml, yarn.lock, bun.lockb) and adapts hook commands, defaulting to npm, so the setup works in any repo without manual configuration."}], "edges": [{"source": "skills_skills_misc_setup_pre_commit_skill", "target": "skills_skills_misc_setup_pre_commit_husky", "relation": "references", "confidenc