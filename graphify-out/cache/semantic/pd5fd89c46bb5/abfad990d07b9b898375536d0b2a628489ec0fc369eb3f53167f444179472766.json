{"nodes": [{"id": "skills_skills_engineering_codebase_design_skill", "label": "Codebase Design Skill", "file_type": "document", "source_file": "skills/skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_engineering_codebase_design_skill_module", "label": "Module", "file_type": "concept", "source_file": "skills/skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_engineering_codebase_design_skill_interface", "label": "Interface", "file_type": "concept", "source_file": "skills/skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_engineering_codebase_design_skill_depth", "label": "Depth", "file_type": "concept", "source_file": "skills/skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Depth is leverage at the interface, not a ratio of implementation lines to interface lines \u2014 Ousterhout's ratio framing was rejected because it rewards padding the implementation."}, {"id": "skills_skills_engineering_codebase_design_skill_seam", "label": "Seam", "file_type": "concept", "source_file": "skills/skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Term borrowed from Michael Feathers: a place where you can alter behaviour without editing in that place. 'Boundary' is avoided because it is overloaded by DDD's bounded context."}, {"id": "skills_skills_engineering_codebase_design_skill_adapter", "label": "Adapter", "file_type": "concept", "source_file": "skills/skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_engineering_codebase_design_skill_leverage", "label": "Leverage", "file_type": "concept", "source_file": "skills/skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_engineering_codebase_design_skill_locality", "label": "Locality", "file_type": "concept", "source_file": "skills/skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_engineering_codebase_design_skill_deletion_test", "label": "Deletion Test", "file_type": "rationale", "source_file": "skills/skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If deleting the module makes complexity vanish it was a pass-through; if complexity reappears across N callers it was earning its keep."}, {"id": "skills_skills_engineering_codebase_design_skill_interface_test_surface", "label": "Interface Is the Test Surface", "file_type": "rationale", "source_file": "skills/skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Callers and tests cross the same seam; if you want to test past the interface the module is probably the wrong shape."}, {"id": "skills_skills_engineering_codebase_design_skill_two_adapter_rule", "label": "Two Adapters Rule", "file_type": "rationale", "source_file": "skills/skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Don't introduce a seam unless something actually varies across it \u2014 one adapter means a hypothetical seam, two adapters (typically production + test) mean a real one."}, {"id": "skills_skills_engineering_codebase_design_skill_testability_principles", "label": "Testability Principles", "file_type": "rationale", "source_file": "skills/skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accept dependencies instead of creating them, return results instead of producing side effects, keep the surface small."}, {"id": "skills_skills_engineering_codebase_design_skill_vocabulary", "label": "Shared Vocabulary Discipline", "file_type": "rationale", "source_file": "skills/skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consistent language is the whole point \u2014 use the glossary terms exactly (module, interface, depth, seam, adapter, leverage, locality) and never substitute component, service, API, or boundary."}], "edges": [{"source": "skills_skills_engineering_codebase_design_skill", "target": "skills_skills_engineering_codebase_design_skill_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_engineering_codebase_design_skill", "target": "skills_skills_engineering_codebase_design_skill_interface", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_engineering_codebase_design_skill", "target": "skills_skills_engineering_codebase_design_skill_depth", "relation": "references", "confidence": "EXTRACTED", "confidence_score"