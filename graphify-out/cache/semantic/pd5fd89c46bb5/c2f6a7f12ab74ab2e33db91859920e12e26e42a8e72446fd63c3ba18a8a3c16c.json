{"nodes": [{"id": "skills_skills_misc_git_guardrails_claude_code_skill", "label": "Git Guardrails for Claude Code", "file_type": "document", "source_file": "skills/skills/skills/misc/git-guardrails-claude-code/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_misc_git_guardrails_claude_code_pretooluse_hook", "label": "PreToolUse Hook", "file_type": "concept", "source_file": "skills/skills/skills/misc/git-guardrails-claude-code/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Intercepts and blocks dangerous git commands before Claude executes them; the blocked invocation is rejected with a message that Claude does not have authority to access the command."}, {"id": "skills_skills_misc_git_guardrails_claude_code_blocked_commands", "label": "Blocked Commands List", "file_type": "concept", "source_file": "skills/skills/skills/misc/git-guardrails-claude-code/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git push (all variants), reset --hard, clean -f/-fd, branch -D, and checkout ./restore . are blocked because they irreversibly destroy work; the verification test expects exit code 2 and a BLOCKED message on stderr."}, {"id": "skills_skills_misc_git_guardrails_claude_code_installation_scope", "label": "Installation Scope (project vs global)", "file_type": "concept", "source_file": "skills/skills/skills/misc/git-guardrails-claude-code/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scope is a user decision: this project only (.claude/settings.json) or all projects (~/.claude/settings.json), and the hook must be merged into an existing hooks.PreToolUse array without overwriting other settings."}], "edges": [{"source": "skills_skills_misc_git_guardrails