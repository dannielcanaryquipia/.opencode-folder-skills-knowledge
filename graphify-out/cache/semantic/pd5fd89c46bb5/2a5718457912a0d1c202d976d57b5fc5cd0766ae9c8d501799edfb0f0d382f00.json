{"nodes": [{"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_references_audit_design_system_audit", "label": "Design System Audit", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/references/audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measure drift from a single visual source of truth; run the audit before proposing changes, report findings first, apply fixes only when asked."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_references_audit_token_coverage_checks", "label": "Token Coverage Checks", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/references/audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grep-based checks for hardcoded colors, raw fontSize, off-scale spacing, raw borderRadius, legacy shadows, and multiple theme entry points; each hit outside the theme directory is a candidate for tokenization, not automatically a violation (one-off-with-comment exemption)."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_references_audit_escape_scoring_per_100_sloc", "label": "Escapes-per-100-SLOC Scoring", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/references/audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normalizing raw hit counts by source lines makes audit runs comparable over time; <0.5 healthy, 0.5-2.0 drifting, >2.0 systemic; highest-scoring category is usually the first migration target."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_references_audit_component_completeness_contract", "label": "Component Completeness Contract", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/references/audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Variant prop over boolean soup, sizes map to spacing/typography tokens, pressed feedback via Pressable style function, disabled/loading handled, style merged last, accessibilityRole set with >=44pt touch target, tokens only."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_references_audit_incremental_adoption_strategy", "label": "Incremental Adoption Strategy", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/references/audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Big-bang conversion produces one huge unreviewable diff and stalls half-done. Create tokens first from the values the audit found most often (an aspirational theme gets bypassed); typography before spacing because it is the highest-visibility win touching the fewest layout decisions; convert one worst-offender completely as reference pattern, then per-screen, re-running the audit after each phase."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_references_audit_component_documentation_template", "label": "Component Documentation Template", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/references/audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_references_audit_new_component_proposal_process", "label": "New Component Proposal Process", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/references/audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prove the existing component set cannot cover the repeated need before designing a new primitive; if the what's-missing column is empty for any closest-component row, extend that component's variants instead of adding a new one."}], "edges": [{"source": "skills_expo_skills_plugins_expo_skills_expo_design_system_references_audit_token_coverage_checks", "target": "skills_expo_skills_plugins_expo_skills_expo_design_system_references_audit_design_system_audit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/references/audit.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_design_system_references_audit_escape_scoring_per_100_sloc", "target": "skills_expo_skills_plugins_expo_skills_expo_design_system_references_audit_design_system_audit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/references/audit.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_design_system_references_audit_component_completeness_contract", "target": "skills_expo_skills_plugins_expo_skills_expo_design_system_references_audit_design_system_audit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/references/audit.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_design_system_references_audit_incremental_adoption_strategy", "target": "skills_expo_skills_plugins_expo_skills_expo_design_system_references_audit_design_system_audit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/references/audit.md", "source_location": null,