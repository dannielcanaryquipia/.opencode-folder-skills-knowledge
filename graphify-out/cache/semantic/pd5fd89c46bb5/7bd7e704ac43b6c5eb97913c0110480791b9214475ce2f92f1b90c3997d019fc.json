{"nodes": [{"id": "skills_expo_skills_plugins_expo_skills_expo_data_fetching_skill_expo_data_fetching", "label": "Expo Data Fetching Skill", "file_type": "document", "source_file": "skills/expo-skills/plugins/expo/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_data_fetching_skill_fetch_api_pattern", "label": "Fetch API Usage Pattern", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer platform fetch over axios in Expo; always check response.ok and parse JSON explicitly so HTTP failures become typed errors rather than silently resolved promises."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_data_fetching_skill_react_query", "label": "React Query (TanStack Query)", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_data_fetching_skill_swr", "label": "SWR", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_data_fetching_skill_api_error_class", "label": "ApiError Typed Error Class", "file_type": "code", "source_file": "skills/expo-skills/plugins/expo/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_data_fetching_skill_retry_backoff", "label": "Retry with Exponential Backoff", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bounded retry loop with 2^i delay absorbs transient network failures without hammering the server; rethrows after the last attempt."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_data_fetching_skill_secure_store_auth", "label": "Token Management with expo-secure-store", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auth tokens must live in SecureStore (Keychain/Keystore), never AsyncStorage; single-flight refresh promise prevents concurrent refresh storms."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_data_fetching_skill_expo_public_env_vars", "label": "EXPO_PUBLIC_ Environment Variables", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EXPO_PUBLIC_ variables are inlined into the client bundle at build time, so they can hold client-safe URLs but never secrets; server secrets need non-prefixed vars in API routes/loaders."}], "edges": [{"source": "skills_expo_skills_plugins_expo_skills_expo_data_fetching_skill_expo_data_fetching", "target": "skills_expo_skills_plugins_expo_skills_expo_data_fetching_references_expo_router_loaders_md_expo_router_loaders_reference", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-data-fetching/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_data_fetching_skill_expo_data_fetching", "target": "sk