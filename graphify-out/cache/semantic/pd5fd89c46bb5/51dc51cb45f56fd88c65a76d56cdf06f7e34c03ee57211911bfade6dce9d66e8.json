{"nodes": [{"id": "skills_expo_skills_plugins_expo_skills_expo_brownfield_skill_expo_brownfield", "label": "Expo Brownfield Skill", "file_type": "document", "source_file": "skills/expo-skills/plugins/expo/skills/expo-brownfield/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_brownfield_skill_brownfield_app", "label": "Brownfield App", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-brownfield/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An existing native iOS/Android app that adopts React Native incrementally instead of a rewrite; both brownfield approaches preserve the existing native investment."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_brownfield_skill_greenfield_app", "label": "Greenfield App", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-brownfield/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_brownfield_skill_isolated_approach", "label": "Isolated Brownfield Approach", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-brownfield/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Choose when the native team must consume RN as a plain AAR/XCFramework without Node/Yarn/RN tooling, when teams/repos/release cadences are separate, when the native build is heavily customized (Tuist/Bazel/custom Gradle), or when cheap removal and independent RN upgrades matter. RN ships as a prebuilt artifact with the JS bundle embedded."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_brownfield_skill_integrated_approach", "label": "Integrated Brownfield Approach", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-brownfield/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Choose when a single team owns native and RN code and wants hot reload, JS source maps, autolinked Expo modules, and one unified Gradle/CocoaPods build; trades a larger build-system footprint for end-to-end iteration speed."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_brownfield_skill_expo_sdk_55", "label": "Expo SDK 55 Minimum for Brownfield", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-brownfield/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SDK 55 is the floor because earlier SDKs lack expo-brownfield and the ExpoReactHostFactory/ExpoReactNativeFactory entry points; pinning the same SDK across the RN project and embedded dependencies avoids version clashes."}], "edges": [{"source": "skills_expo_skills_plugins_expo_skills_expo_brownfield_skill_expo_brownfield", "target": "skills_expo_skills_plugins_expo_skills_expo_brownfield_skill_brownfield_app", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-brownfield/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_brownfield_skill_expo_brownfield", "target": "skills_expo_skills_plugins_expo_skills_expo_brownfield_skill_greenfield_app", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-brownfield/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_brownfield_skill_expo_brownfield", "target": "skills_expo_skills_plugins_expo_skills_expo_brownfield_skill_isolated_approach", "relation": "