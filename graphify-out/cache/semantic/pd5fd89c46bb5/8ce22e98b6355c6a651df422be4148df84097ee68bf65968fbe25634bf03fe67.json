{"nodes": [{"id": "docs_engineering_code_review_code_review", "label": "code-review (two-axis review skill)", "file_type": "document", "source_file": "skills/skills/docs/engineering/code-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reviews the diff between HEAD and a fixed point along two separate axes run as parallel sub-agents; keeping them separate is the whole point because a change can pass one axis and fail the other."}, {"id": "docs_engineering_code_review_standards_axis", "label": "Standards axis", "file_type": "concept", "source_file": "skills/skills/docs/engineering/code-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asks whether the diff conforms to how this repo writes code - its CODING_STANDARDS.md or CONTRIBUTING.md, plus a fixed baseline of ~12 Fowler code smells."}, {"id": "docs_engineering_code_review_spec_axis", "label": "Spec axis", "file_type": "concept", "source_file": "skills/skills/docs/engineering/code-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asks the orthogonal question - does the code do what the issue or spec actually asked, without missing requirements or smuggling in scope creep. Needs an issue reference to find the origin spec; otherwise it skips and reports no spec available."}, {"id": "docs_engineering_code_review_fowler_smell_baseline", "label": "Fowler smell baseline", "file_type": "rationale", "source_file": "skills/skills/docs/engineering/code-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A curated ~12 high-signal Bad Smells in Code (Mysterious Name, Duplicated Code, Feature Envy, Data Clumps, Primitive Obsession, Repeated Switches, Shotgun Surgery, Divergent Change, Speculative Generality, Message Chains, Middle Man, Refused Bequest). Two binding rules: a documented repo standard overrides it, and every smell is a judgement call, never a hard violation."}], "edges": [{"source": "docs_engineering_code_review_code_review", "target": "docs_engineering_code_review_standards_axis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/code-review.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_code_review_code_review", "target": "docs_engineering_code_review_spec_axis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/code-review.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_code_review_code_review", "target": "docs_engineering_code_review_fowler_smell_baseline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/code-review.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_code_review_code_review", "target": "docs_engineering_implement_implement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/code-review.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_code_review_code_review", "target": "docs_engineering_tdd_tdd", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/code-review.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_code_review_code_review", "target": "docs_engineering_setup_matt_pocock_skills_setup_matt_pocock_skills", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/code-review.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_code_review_code_review", "tar