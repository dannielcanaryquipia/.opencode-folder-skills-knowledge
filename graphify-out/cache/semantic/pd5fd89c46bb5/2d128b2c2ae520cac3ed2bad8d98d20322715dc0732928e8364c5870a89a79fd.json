{"nodes": [{"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_skill_expo_design_system", "label": "Expo Design System Skill", "file_type": "document", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_skill_design_tokens_theme", "label": "Design Token Theme (src/theme/)", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_skill_semantic_color_tokens", "label": "Semantic Color Tokens", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_skill_four_point_spacing_grid", "label": "4-Point Spacing Grid", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One scale named by size (not use) keeps layout rhythm consistent; snap to nearest step rather than inventing values, and promote recurring in-between multiples into named steps."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_skill_typography_ramp", "label": "Named Typography Ramp", "file_type": "concept", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_skill_component_contract", "label": "Component Contract (variants/sizes/states/style)", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit variants, sizes mapped to tokens, touch states including pressed feedback, and style merged last give predictable APIs: callers may override layout but not identity - a color override signals a missing variant."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_skill_themed_text", "label": "ThemedText Component", "file_type": "code", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_skill_button_primitive", "label": "Button Primitive", "file_type": "code", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_skill_composition_over_configuration", "label": "Composition over Configuration", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Content-describing props (leftIcon, subtitle, footerText) proliferate; accepting children with token padding produces components that outlive any prop explosion."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_skill_component_promotion_rule", "label": "Component Promotion Rule", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promote only when a view appears on two or more screens, has a nameable role, and its API is smaller than its implementation; wrong abstractions cost more than duplication, so move one step at a time, never speculatively."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_skill_self_critique_pass", "label": "Self-Critique Design Pass", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After building a screen, check hierarchy/contrast, proximity/white space, repetition/unity, and alignment; each failure maps to a system-level fix (tokens/components), not a local tweak."}, {"id": "skills_expo_skills_plugins_expo_skills_expo_design_system_skill_static_safe_vs_hook_only", "label": "Static-safe vs Hook-only Colors", "file_type": "rationale", "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic/platform colors resolve on-device and are safe at module scope; brand light/dark pairs depend on useColorScheme at render time, so they can only be applied inside components - never mix both patterns in one token file."}], "edges": [{"source": "skills_expo_skills_plugins_expo_skills_expo_design_system_skill_expo_design_system", "target": "skills_expo_skills_plugins_expo_skills_expo_design_system_skill_design_tokens_theme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/expo-skills/plugins/expo/skills/expo-design-system/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_expo_skills_plugins_expo_skills_expo_design_system_skill_design_tokens_theme", "target": "skills_expo