{"nodes": [{"id": "skills_skills_productivity_teach_glossary_format", "label": "GLOSSARY.md Format", "file_type": "document", "source_file": "skills/skills/skills/productivity/teach/GLOSSARY-FORMAT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_productivity_teach_glossary_format_glossary_md", "label": "GLOSSARY.md Canonical Glossary", "file_type": "concept", "source_file": "skills/skills/skills/productivity/teach/GLOSSARY-FORMAT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLOSSARY.md is the canonical language of the teaching workspace \u2014 all explainers, exercises, and learning records adhere to its terminology; building it is itself part of learning because compressing a concept into a tight definition is evidence the user understands it."}, {"id": "skills_skills_productivity_teach_glossary_format_glossary_rules", "label": "Glossary Term Rules", "file_type": "concept", "source_file": "skills/skills/skills/productivity/teach/GLOSSARY-FORMAT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add a term only when the user understands it (a record of compressed knowledge, not a dictionary to read); be opinionated \u2014 pick one canonical term and list the rest as aliases to avoid; keep definitions to one or two sentences defining what the term IS; reuse the glossary's own terms inside definitions; group under subheadings when clusters emerge; flag ambiguities explicitly; revise definitions in place as understanding deepens."}], "edges": [{"source": "skills_skills_productivity_teach_glossary_format", "target": "skills_skills_productivity_teach_glossary_format_glossary_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/skills/productivity/teach/GLOSSARY-FORMAT.md", "source_loca