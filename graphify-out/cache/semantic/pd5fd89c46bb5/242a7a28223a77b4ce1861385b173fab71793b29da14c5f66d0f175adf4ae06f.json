{"nodes": [{"id": "docs_engineering_resolving_merge_conflicts_resolving_merge_conflicts", "label": "resolving-merge-conflicts (intent-based)", "file_type": "document", "source_file": "skills/skills/docs/engineering/resolving-merge-conflicts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Works through an in-progress git merge or rebase conflict hunk by hunk and finishes the operation - the merge always gets finished, never --abort."}, {"id": "docs_engineering_resolving_merge_conflicts_resolve_by_intent", "label": "Resolve by intent", "file_type": "rationale", "source_file": "skills/skills/docs/engineering/resolving-merge-conflicts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The trap in a conflict is treating it as a text problem. Before touching a hunk it traces each side to its primary source (commit message, PR, original issue) to preserve both intents where compatible; it never invents behaviour to paper over a clash."}], "edges": [{"source": "docs_engineering_resolving_merge_conflicts_resolving_merge_conflicts", "target": "docs_engineering_resolving_merge_conflicts_resolve_by_intent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/resolving-merge-conflicts.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_resolving_merge_conflicts_resolving_merge_conflicts", "target": "docs_engineering_diagnosing_bugs_diagnosing_bugs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/docs/engineering/resolving-merge-conflicts.md", "source_location": null, "weight": 1.0}, {"source": "docs_engineering_resolving_merge_conflicts_resolving_merge_conflicts", "target": "docs_engineering_ask_matt_ask_matt", "relation": "references", "confidence": "EXTRACTED", "confidence_score":