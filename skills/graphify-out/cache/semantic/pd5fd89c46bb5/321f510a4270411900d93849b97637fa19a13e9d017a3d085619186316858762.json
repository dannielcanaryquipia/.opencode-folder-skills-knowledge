{"nodes": [{"id": "skills_skills_skills_engineering_tdd_skill_tdd", "label": "Test-Driven Development", "file_type": "concept", "source_file": "skills/skills/engineering/tdd/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The red->green loop only produces tests worth keeping when each section is consulted before and during the cycle, not after."}, {"id": "skills_skills_skills_engineering_tdd_skill_seam", "label": "Seam", "file_type": "concept", "source_file": "skills/skills/engineering/tdd/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test only at pre-agreed seams - no test is written at an unconfirmed seam; agreeing seams up front lands testing effort on critical paths instead of every edge case."}, {"id": "skills_skills_skills_engineering_tdd_skill_red_green_loop", "label": "Red-Green Loop", "file_type": "concept", "source_file": "skills/skills/engineering/tdd/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Red before green, one slice at a time; don't anticipate future tests or add speculative features."}, {"id": "skills_skills_skills_engineering_tdd_skill_anti_patterns", "label": "TDD Anti-patterns", "file_type": "concept", "source_file": "skills/skills/engineering/tdd/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Horizontal slicing tests imagined behavior (the shape of things, not behavior), so work in vertical slices instead; tautological tests pass by construction so expected values must come from an independent source of truth."}, {"id": "skills_skills_skills_engineering_tdd_skill_vertical_slice", "label": "Vertical Slice", "file_type": "concept", "source_file": "skills/skills/engineering/tdd/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_skills_engineering_tdd_skill_tracer_bullet", "label": "Tracer Bullet", "file_type": "concept", "source_file": "skills/skills/engineering/tdd/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each vertical-slice test is a tracer bullet that responds to what the last cycle taught you."}], "edges": [{"source": "skills_skills_skills_engineering_tdd_skill_tdd", "target": "skills_skills_skills_engineering_tdd_mocking_system_boundary_mocking", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/tdd/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_engineering_tdd_skill_tdd", "target": "skills_skills_skills_engineering_tdd_skill_seam", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/tdd/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_engineering_tdd_skill_tdd", "target": "skills_skills_skills_engineering_tdd_skill_red_green_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/tdd/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_engineering_tdd_skill_tdd", "target": "skills_skills_skills_engineering_tdd_skill_anti_patterns", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/tdd/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_engineering_tdd_skill_tdd", "target": "skills_skills_skills_engineering_tdd_skill_vertical_slice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/tdd/SKILL.md", "source_location": null, "weight": 1.