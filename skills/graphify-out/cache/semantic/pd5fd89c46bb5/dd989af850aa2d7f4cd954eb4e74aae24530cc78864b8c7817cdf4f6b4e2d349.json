{"nodes": [{"id": "skills_unreal_engine_cpp_pro_skill", "label": "unreal-engine-cpp-pro", "file_type": "concept", "source_file": "unreal-engine-cpp-pro/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Performance first and GC safety by discipline: disable ticking by default, prefer timers, avoid Cast in hot loops, cache lookups outside Tick; trade-off is convention for robustness."}, {"id": "skills_unreal_engine_cpp_pro_uobject_hygiene", "label": "UObject hygiene", "file_type": "rationale", "source_file": "unreal-engine-cpp-pro/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GC correctness requires every UObject* member wrapped in UPROPERTY; TStrongObjectPtr only for roots outside the UObject graph; IsValid() over nullptr to handle pending-kill state."}, {"id": "skills_unreal_engine_cpp_pro_unreal_engine_5_x", "label": "Unreal Engine 5.x", "file_type": "concept", "source_file": "unreal-engine-cpp-pro/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_unreal_engine_cpp_pro_c_plus_plus", "label": "C++", "file_type": "concept", "source_file": "unreal-engine-cpp-pro/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "skills_unreal_engine_cpp_pro_skill", "target": "skills_unreal_engine_cpp_pro_uobject_hygiene", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "unreal-engine-cpp-pro/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_unreal_engine_cpp_pro_skill", "target": "skills_unreal_engine_cpp_pro_unreal_engine_5_x", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "unreal-engine-cpp-pro/SKILL.md", "source_location": null, "weight": 1.0}, {"sou