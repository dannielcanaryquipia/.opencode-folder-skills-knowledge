{"nodes": [{"id": "skills_skills_skills_engineering_codebase_design_deepening_dependencycategories", "label": "Dependency Categories", "file_type": "concept", "source_file": "skills/skills/engineering/codebase-design/DEEPENING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classify a deepening candidate's dependencies: in-process (always deepenable, no adapter), local-substitutable (test stand-in exists), remote-but-owned (ports & adapters), true external (injected port, mock adapter)."}, {"id": "skills_skills_skills_engineering_codebase_design_deepening_seamdiscipline", "label": "Seam Discipline", "file_type": "concept", "source_file": "skills/skills/engineering/codebase-design/DEEPENING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One adapter means a hypothetical seam, two adapters means a real one \u2014 don't introduce a port unless at least two adapters are justified; keep internal seams private, don't expose them through the interface just because tests use them."}, {"id": "skills_skills_skills_engineering_codebase_design_deepening_replacedontlayer", "label": "Replace, Don't Layer Testing", "file_type": "concept", "source_file": "skills/skills/engineering/codebase-design/DEEPENING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Old unit tests on shallow modules become waste once tests at the deepened module's interface exist \u2014 delete them; tests should survive internal refactors and describe behaviour, not implementation."}], "edges": [{"source": "skills_skills_skills_engineering_codebase_design_deepening_dependencycategories", "target": "skills_skills_skills_engineering_codebase_design_deepening_replacedontlayer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/codebase-design/DEEPENING.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_engineering_codebase_design_deepening_seamdiscipline", "target": "skills_skills_skills_engineering_codebase_design_skill_adapter", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/codebase-design/DEEPENING.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_engineering_codebase_design_deepening_seamdiscipline", "target": "skills_skills_skills_engineering_codebase_design_skill_seam", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/codebase-design/DEEPENING.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_engineering_codebase_design_deepening_replacedontlayer", "target": "skills_skills_skills_engineering_codebase_design_skill_interface", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/codebase-design/DEEPENING.md", "source_location": null, "weight": 1.0}], "hyperedges": []}