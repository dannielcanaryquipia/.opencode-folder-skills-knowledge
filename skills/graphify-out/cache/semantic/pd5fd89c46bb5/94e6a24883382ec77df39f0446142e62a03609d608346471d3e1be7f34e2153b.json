{"nodes": [{"id": "skills_skills_skills_engineering_diagnosing_bugs_skill_diagnosingbugs", "label": "Diagnosing Bugs", "file_type": "concept", "source_file": "skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A discipline for hard bugs and performance regressions: reproduce \u2192 minimise \u2192 hypothesise \u2192 instrument \u2192 fix \u2192 regression-test \u2192 cleanup + post-mortem; skip phases only when explicitly justified."}, {"id": "skills_skills_skills_engineering_diagnosing_bugs_skill_feedbackloop", "label": "Feedback Loop", "file_type": "concept", "source_file": "skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase 1 is the skill \u2014 everything else is mechanical: no red-capable, deterministic, fast, agent-runnable command that goes red on this bug means no hypothesising. Jumping straight to a hypothesis is the exact failure this skill prevents."}, {"id": "skills_skills_skills_engineering_diagnosing_bugs_skill_tightloop", "label": "Tight Loop", "file_type": "concept", "source_file": "skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Treat the loop as a product: make it faster, sharper (assert the specific symptom, not 'didn't crash') and more deterministic; a 2-second deterministic loop is a debugging superpower; raise flaky-bug reproduction rate until debuggable."}, {"id": "skills_skills_skills_engineering_diagnosing_bugs_skill_regressiontest", "label": "Regression Test", "file_type": "concept", "source_file": "skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Write the regression test before the fix, but only if a correct seam exists; the minimised repro becomes the clean regression test."}, {"id": "skills_skills_skills_engineering_diagnosing_bugs_skill_correctseam", "label": "Correct Seam", "file_type": "concept", "source_file": "skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A seam where the test exercises the real bug pattern as it occurs at the call site; if no correct seam exists, that itself is the finding \u2014 the architecture is preventing the bug from being locked down."}], "edges": [{"source": "skills_skills_skills_engineering_diagnosing_bugs_skill_diagnosingbugs", "target": "skills_skills_skills_engineering_diagnosing_bugs_skill_feedbackloop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_engineering_diagnosing_bugs_skill_diagnosingbugs", "target": "skills_skills_skills_engineering_diagnosing_bugs_skill_tightloop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_engineering_diagnosing_bugs_skill_feedbackloop", "target": "skills_skills_skills_engineering_diagnosing_bugs_skill_tightloop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_engineering_diagnosing_bugs_skill_diagnosingbugs", "target": "skills_skills_skills_engineering_diagnosing_bugs_skill_regressiontest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_engineering_diagnosing_bugs_skill_diagnosingbugs", "target": "skills_skills_skills_engineering_diagnosing_bugs_skill_correctseam", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_engineering_diagnosing_bugs_skill_correctseam", "target": "skills_skills_skills_engineering_codebase_design_skill_seam", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_engineering_diagnosing_bugs_skill_diagnosingbugs", "target": "skills_skills_skills_engineering_improve_codebase_architecture_skill_improvecodebasearchitecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/diagnosing-bugs/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": []}