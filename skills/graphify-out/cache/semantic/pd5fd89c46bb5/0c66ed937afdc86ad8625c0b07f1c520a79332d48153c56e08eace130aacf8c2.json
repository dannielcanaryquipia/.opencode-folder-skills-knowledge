{"nodes": [{"id": "skills_skills_skills_in_progress_writing_beats_skill", "label": "writing-beats", "file_type": "concept", "source_file": "skills/skills/in-progress/writing-beats/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_skills_in_progress_writing_beats_skill_beat", "label": "beat", "file_type": "concept", "source_file": "skills/skills/in-progress/writing-beats/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One move in the journey that does one thing then stops, sized by what it needs (a sentence to several paragraphs). If a 'beat' needs five paragraphs and three subheadings, it's two beats glued together \u2014 split it."}, {"id": "skills_skills_skills_in_progress_writing_beats_skill_grounding", "label": "grounding", "file_type": "rationale", "source_file": "skills/skills/in-progress/writing-beats/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every concept must be grounded before a beat can lean on it; a beat that reaches for an ungrounded concept loses the reader \u2014 the one move the journey can't make. The unit is the concept, not the word for it. The big lever is what you make a prerequisite versus what you ground inside the piece."}, {"id": "skills_skills_skills_in_progress_writing_beats_skill_prerequisite", "label": "prerequisite", "file_type": "concept", "source_file": "skills/skills/in-progress/writing-beats/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_skills_in_progress_writing_beats_skill_concept", "label": "concept", "file_type": "concept", "source_file": "skills/skills/in-progress/writing-beats/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_skills_in_progress_writing_beats_skill_journey", "label": "choose-your-own-adventure journey", "file_type": "rationale", "source_file": "skills/skills/in-progress/writing-beats/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A candidate beat is only reachable if everything it requires is already grounded; picking a beat that grounds concept X unlocks every beat waiting on X. The article ends when the journey is complete \u2014 not when the pile is empty."}], "edges": [{"source": "skills_skills_skills_in_progress_writing_beats_skill", "target": "skills_skills_skills_in_progress_writing_beats_skill_beat", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/writing-beats/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_writing_beats_skill", "target": "skills_skills_skills_in_progress_writing_beats_skill_grounding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/writing-beats/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_writing_beats_skill", "target": "skills_skills_skills_in_progress_writing_beats_skill_journey", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/writing-beats/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_writing_beats_skill_beat", "target": "skills_skills_skills_in_progress_writing_beats_skill_grounding", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/writing-beats/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_writing_beats_skill_grounding", "target": "skills_skills_skills_in_progress_writing_beats_skill_prerequisite", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/writing-beats/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_writing_beats_skill_grounding", "target": "skills_skills_skills_in_progress_writing_beats_skill_concept", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/writing-beats/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_writing_beats_skill", "target": "skills_skills_skills_in_progress_writing_shape_skill", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "skills/skills/in-progress/writing-beats/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_writing_beats_skill_grounding", "target": "skills_skills_skills_in_progress_writing_shape_skill_grounding", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "skills/skills/in-progress/writing-beats/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": []}