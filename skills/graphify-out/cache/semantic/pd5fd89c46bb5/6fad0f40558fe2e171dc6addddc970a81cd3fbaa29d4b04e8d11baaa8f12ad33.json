{"nodes": [{"id": "skills_skills_agents_writingdocs_writingdocsmd", "label": "Writing docs pages guide", "file_type": "document", "source_file": "skills/.agents/writing-docs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_agents_writingdocs_docspage", "label": "Docs page (aihero.dev distributed router)", "file_type": "rationale", "source_file": "skills/.agents/writing-docs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every promoted skill gets a human-facing docs page at docs/<bucket>/<skill-name>.md published at aihero.dev/skills-<name>; its job is to relieve the cognitive load of remembering user-invoked skills - the pages are collectively a distributed router, each a node, with every link absolute."}, {"id": "skills_skills_agents_writingdocs_leadingword", "label": "Leading word surfacing", "file_type": "rationale", "source_file": "skills/.agents/writing-docs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The non-negotiable of a docs page is surfacing the skill's leading word / defining idea (deep module, tracer bullet, red-green) - it pays off twice: the reader learns what the skill is and the word they'll later think with to reach for it."}], "edges": [{"source": "skills_skills_agents_writingdocs_writingdocsmd", "target": "skills_skills_agents_writingdocs_docspage", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/.agents/writing-docs.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_agents_writingdocs_docspage", "target": "skills_skills_claude_askmatt_router", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/.agents/writing-docs.md", "source_location": null, "weight": 1.0}, {"source": "skills_sk