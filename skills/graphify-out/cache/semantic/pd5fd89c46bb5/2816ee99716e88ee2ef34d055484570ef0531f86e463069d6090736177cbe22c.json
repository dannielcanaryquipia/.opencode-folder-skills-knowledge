{"nodes": [{"id": "skills_skills_changelog_changelog", "label": "CHANGELOG.md", "file_type": "document", "source_file": "skills/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_changelog_wayfinder", "label": "Wayfinder (decision mapping flow)", "file_type": "rationale", "source_file": "skills/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renamed from decision-mapping: charts a route through a foggy problem (fog of war, frontier, the map). Plan, don't do - the map produces decisions, not deliverables; destination is the leading word; claim by assignment, native blocking, HITL/AFK classification, and a fourth task ticket type for manual work."}, {"id": "skills_skills_changelog_wayfindermap", "label": "Wayfinder map", "file_type": "concept", "source_file": "skills/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The map is an index, not a store: a single wayfinder:map issue whose child issues are the tickets; a decision lives in exactly one place. Collaborative by default - moved off local Markdown onto the repo's issue tracker, tracker-agnostic behind a pointer."}, {"id": "skills_skills_changelog_blockingedges", "label": "Blocking edges", "file_type": "concept", "source_file": "skills/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tracer-bullet tickets each declare their blocking edges; a local file writes them as text, a real tracker as native blocking links so the frontier is visible and several agents can run in parallel."}, {"id": "skills_skills_changelog_codereview", "label": "Code review (Fowler smell baseline)", "file_type": "rationale", "source_file": "skills/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promoted from in-progress/ to engineering/ with an always-on Fowler smell baseline (~12 high-signal Bad Smells in Code); a documented repo standard overrides the baseline and every smell is a judgement call, never a hard violation."}, {"id": "skills_skills_changelog_grilling", "label": "Grilling confirmation gate and facts-vs-decisions", "file_type": "rationale", "source_file": "skills/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A confirmation gate stops the agent from enacting the plan until shared understanding is confirmed, and grilling splits facts (look them up) from decisions (put each to the human) so a grilling agent never races ahead and answers its own questions."}], "edges": [{"source": "skills_skills_changelog_changelog", "target": "skills_skills_changelog_wayfinder", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/CHANGELOG.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_changelog_changelog", "target": "skills_skills_changelog_blockingedges", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/CHANGELOG.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_changelog_changelog", "target": "skills_skills_changelog_codereview", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/CHANGELOG.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_changelog_changelog", "target": "skills_skills_changelog_grilling", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/CHANGELOG.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_changelog_wayfinder", "target": "skills_skills_changelog