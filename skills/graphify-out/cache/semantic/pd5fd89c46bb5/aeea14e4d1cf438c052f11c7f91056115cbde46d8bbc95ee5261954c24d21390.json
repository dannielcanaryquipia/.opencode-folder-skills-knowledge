{"nodes": [{"id": "skills_image_to_code_skill", "label": "image-to-code", "file_type": "concept", "source_file": "image-to-code/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_image_to_code_skill_image_first_workflow", "label": "Image-First Workflow", "file_type": "rationale", "source_file": "image-to-code/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The generated image is the design source and the code is the translation layer; freeform coding first produces generic reinterpretations, so generation must precede analysis which must precede implementation."}, {"id": "skills_image_to_code_skill_deep_image_analysis", "label": "Deep Image Analysis", "file_type": "rationale", "source_file": "image-to-code/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Images are treated as a design specification: extract exact text, type scale, spacing relationships, color logic and component behavior before coding, otherwise implementation drifts into generic defaults."}, {"id": "skills_image_to_code_skill_section_image_generation", "label": "Section Image Generation", "file_type": "rationale", "source_file": "image-to-code/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One section = one large readable image; compressed boards shrink text below analyzability and cropping old images destroys spacing, proportions and type-scale relationships, so fresh standalone regeneration is preferred."}, {"id": "skills_image_to_code_skill_anti_ai_slop", "label": "Anti-AI-Slop", "file_type": "concept", "source_file": "image-to-code/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_image_to_code_skill_hero_minimalism", "label": "Hero Minimalism", "file_type": "rationale", "source_file": "image-to-code/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The first viewport must stay calm and readable on a small laptop; overcrowding it with pills, fake stats and micro-labels destroys hierarchy."}], "edges": [{"source": "skills_image_to_code_skill", "target": "skills_image_to_code_skill_image_first_workflow", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "image-to-code/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_image_to_code_skill_image_first_workflow", "target": "skills_image_to_code_skill_deep_image_analysis", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "image-to-code/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_image_to_code_skill_image_first_workflow", "target": "skills_image_to_code_skill_section_image_generation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "image-to-code/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_image_to_code_skill", "target": "skills_image_to_code_skill_anti_ai_slop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "image-to-code/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_image_to_code_skill", "target": "skills_image_to_code_skill_hero_minimalism", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "image-to-code/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": []}