{"nodes": [{"id": "skills_skills_skills_in_progress_setup_ts_deep_modules_skill", "label": "setup-ts-deep-modules", "file_type": "concept", "source_file": "skills/skills/in-progress/setup-ts-deep-modules/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_skills_in_progress_setup_ts_deep_modules_skill_deep_module", "label": "deep module", "file_type": "rationale", "source_file": "skills/skills/in-progress/setup-ts-deep-modules/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A lot of behaviour behind a small interface. Public vs private is decided by depth: anything in any subfolder is private, so the rule never needs extending to add a folder; packages are flat (one tier of immediate children) and may not nest packages."}, {"id": "skills_skills_skills_in_progress_setup_ts_deep_modules_skill_entry_points", "label": "entry points", "file_type": "concept", "source_file": "skills/skills/in-progress/setup-ts-deep-modules/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The public surface is the package's root files, not one designated index.ts \u2014 several small entry points beat a giant barrel; adding an entry point is just adding a root file."}, {"id": "skills_skills_skills_in_progress_setup_ts_deep_modules_skill_dependency_cruiser", "label": "dependency-cruiser", "file_type": "concept", "source_file": "skills/skills/in-progress/setup-ts-deep-modules/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installed as a devDependency to enforce the four boundary rules (entry-point boundary, intra-package freedom, tests through entry points, no cycles); $1 back-references let a package reach its own internals while outsiders can't."}, {"id": "skills_skills_skills_in_progress_setup_ts_deep_modules_skill_lib_subfolder", "label": "lib/ subfolder", "file_type": "concept", "source_file": "skills/skills/in-progress/setup-ts-deep-modules/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_skills_in_progress_setup_ts_deep_modules_skill_barrel_files", "label": "barrel files", "file_type": "rationale", "source_file": "skills/skills/in-progress/setup-ts-deep-modules/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discouraged explicitly \u2014 keep entry points small and hide implementation in subfolders instead of re-exporting a whole subtree through one index."}, {"id": "skills_skills_skills_engineering_codebase_design_skill", "label": "codebase-design", "file_type": "concept", "source_file": "skills/skills/in-progress/setup-ts-deep-modules/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "skills_skills_skills_in_progress_setup_ts_deep_modules_skill", "target": "skills_skills_skills_in_progress_setup_ts_deep_modules_skill_deep_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/setup-ts-deep-modules/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_setup_ts_deep_modules_skill", "target": "skills_skills_skills_in_progress_setup_ts_deep_modules_skill_dependency_cruiser", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/setup-ts-deep-modules/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_setup_ts_deep_modules_skill", "target": "skills_skills_skills_engineering_codebase_design_skill", "relation": "references", "confidence": "EXTRACTED", "confid