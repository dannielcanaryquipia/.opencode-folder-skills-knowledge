{"nodes": [{"id": "skills_skills_skills_deprecated_qa_skill_qa", "label": "QA Session", "file_type": "concept", "source_file": "skills/skills/deprecated/qa/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deprecated (rationale: interactive QA issue-filing was folded into the triage workflow, which moves incoming issues through triage roles and produces agent-ready issues for implement to pick up)."}, {"id": "skills_skills_skills_deprecated_qa_skill_issuefiling", "label": "Issue Filing", "file_type": "concept", "source_file": "skills/skills/deprecated/qa/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Issues must be durable and written from the user's perspective: no file paths or line numbers (they go stale), describe behaviours not code, use the project's domain language, reproduction steps mandatory."}, {"id": "skills_skills_skills_deprecated_qa_skill_breakdown", "label": "Issue Breakdown", "file_type": "concept", "source_file": "skills/skills/deprecated/qa/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Break a report into many thin issues over few thick ones \u2014 each independently fixable and verifiable, marked with honest blocking relationships, filed in dependency order to maximise parallelism."}, {"id": "skills_skills_skills_deprecated_qa_skill_domainlanguage", "label": "QA Domain Language", "file_type": "concept", "source_file": "skills/skills/deprecated/qa/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "skills_skills_skills_deprecated_qa_skill_qa", "target": "skills_skills_skills_deprecated_qa_skill_issuefiling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/deprecated/q