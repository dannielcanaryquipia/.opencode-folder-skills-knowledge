{"nodes": [{"id": "skills_superpowers_skills_skill", "label": "Writing Skills", "file_type": "concept", "source_file": "superpowers-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_superpowers_skills_skill_tdd_for_docs", "label": "TDD Applied to Documentation", "file_type": "rationale", "source_file": "superpowers-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writing skills IS test-driven development applied to process documentation - no skill without a failing test first; if you didn't watch an agent fail without the skill, you don't know if it teaches the right thing"}, {"id": "skills_superpowers_skills_skill_sdo", "label": "Skill Discovery Optimization", "file_type": "rationale", "source_file": "superpowers-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Descriptions that summarize a skill's workflow create a shortcut agents take - descriptions must state only triggering conditions ('Use when...') so agents read the full skill body"}, {"id": "skills_superpowers_skills_skill_bulletproofing", "file_type": "rationale", "label": "Bulletproofing Against Rationalization", "source_file": "superpowers-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discipline skills need prohibition + rationalization tables + red flags to resist loopholes, but prohibitions backfire on shaping problems - recipes beat prohibitions for wrong-shaped output"}], "edges": [{"source": "skills_superpowers_skills_skill", "target": "skills_superpowers_skills_skill_tdd_for_docs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "superpowers-skills/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "s