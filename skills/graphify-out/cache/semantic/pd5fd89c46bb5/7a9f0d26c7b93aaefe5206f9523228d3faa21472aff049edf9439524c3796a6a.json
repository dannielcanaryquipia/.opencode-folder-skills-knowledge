{"nodes": [{"id": "skills_skills_skills_engineering_codebase_design_skill_codebasedesign", "label": "Codebase Design", "file_type": "concept", "source_file": "skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consistent vocabulary is the whole point \u2014 don't substitute component/service/API/boundary. Rejected framings: depth-as-line-ratio (rewards padding the implementation), interface-as-keyword (too narrow), boundary (overloaded with DDD's bounded context)."}, {"id": "skills_skills_skills_engineering_codebase_design_skill_deepmodule", "label": "Deep Module", "file_type": "concept", "source_file": "skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A lot of behaviour behind a small interface at a clean seam \u2014 a module is deep when a large amount of behaviour sits behind a small interface, shallow when the interface is nearly as complex as the implementation."}, {"id": "skills_skills_skills_engineering_codebase_design_skill_interface", "label": "Interface", "file_type": "concept", "source_file": "skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything a caller must know to use the module correctly: the type signature plus invariants, ordering constraints, error modes, required configuration, and performance characteristics."}, {"id": "skills_skills_skills_engineering_codebase_design_skill_seam", "label": "Seam", "file_type": "concept", "source_file": "skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Michael Feathers: a place where you can alter behaviour without editing in that place; the location at which a module's interface lives. Avoid 'boundary' (overloaded with DDD's bounded context)."}, {"id": "skills_skills_skills_engineering_codebase_design_skill_adapter", "label": "Adapter", "file_type": "concept", "source_file": "skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A concrete thing that satisfies an interface at a seam; describes role (what slot it fills), not substance (what's inside). One adapter means a hypothetical seam; two adapters means a real one."}, {"id": "skills_skills_skills_engineering_codebase_design_skill_depth", "label": "Depth", "file_type": "concept", "source_file": "skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leverage at the interface: the amount of behaviour a caller or test can exercise per unit of interface they have to learn; depth is a property of the interface, not the implementation."}, {"id": "skills_skills_skills_engineering_codebase_design_skill_leverage", "label": "Leverage", "file_type": "concept", "source_file": "skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What callers get from depth: more capability per unit of interface they learn; one implementation pays back across N call sites and M tests."}, {"id": "skills_skills_skills_engineering_codebase_design_skill_locality", "label": "Locality", "file_type": "concept", "source_file": "skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What maintainers get from depth: change, bugs, knowledge, and verification concentrate in one place rather than spreading across callers \u2014 fix once, fixed everywhere."}, {"id": "skills_skills_skills_engineering_codebase_design_skill_deletiontest", "label": "Deletion Test", "file_type": "concept", "source_file": "skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Imagine deleting the module: if complexity vanishes it was a pass-through; if complexity reappears across N callers it was earning its keep."}], "edges": [{"source": "skills_skills_skills_engineering_codebase_design_skill_codebasedesign", "target": "skills_skills_skills_engineering_codebase_design_skill_deepmodule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_engineering_codebase_design_skill_codebasedesign", "target": "skills_skills_skills_engineering_codebase_design_skill_interface", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_engineering_codebase_design_skill_codebasedesign", "target": "skills_skills_skills_engineering_codebase_design_skill_seam", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_engineering_codebase_design_skill_codebasedesign", "target": "skills_skills_skills_engineering_codebase_design_skill_adapter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/engineering/codebase-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_engineering_codebase_design_skill_codebasedesign", "target": "skills_skil