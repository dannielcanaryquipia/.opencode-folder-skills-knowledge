{"nodes": [{"id": "skills_writing_skills_skill", "label": "writing-skills", "file_type": "concept", "source_file": "writing-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skill creation IS TDD applied to process documentation: if you didn't watch an agent fail without the skill, you don't know it teaches the right thing; no skill without a failing test first."}, {"id": "skills_writing_skills_skill_md_frontmatter", "label": "SKILL.md frontmatter", "file_type": "concept", "source_file": "writing-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only name and description are required (max 1024 chars); name uses letters/numbers/hyphens; description is third-person, starts with \"Use when...\", describes ONLY triggering conditions."}, {"id": "skills_writing_skills_tdd_for_documentation", "label": "TDD for documentation", "file_type": "rationale", "source_file": "writing-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RED (baseline pressure scenario without skill) to GREEN (minimal skill) to REFACTOR (close loopholes with rationalization tables and red flags); Iron Law applies to new skills and edits."}, {"id": "skills_writing_skills_claude_search_optimization", "label": "Claude Search Optimization (CSO)", "file_type": "rationale", "source_file": "writing-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Description = when to use, NEVER what the skill does; workflow summaries create a shortcut Claude follows instead of reading the skill body, so the body becomes documentation Claude skips."}, {"id": "skills_writing_skills_writing_great_skills", "label": "writing-great-skills", "file_type": "concept", "source_file": "writing-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_test_driven_development", "label": "test-driven-development (superpowers)", "file_type": "concept", "source_file": "writing-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REQUIRED BACKGROUND: defines the RED-GREEN-REFACTOR cycle that writing-skills adapts to documentation; the same discipline applied to code is applied to skills."}], "edges": [{"source": "skills_writing_skills_skill", "target": "skills_writing_skills_skill_md_frontmatter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "writing-skills/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_writing_skills_skill", "target": "skills_writing_skills_tdd_for_documentation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "writing-skills/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_writing_skills_skill", "target": "skills_writing_skills_claude_search_optimization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "writing-skills/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_writing_skills_skill", "target": "skills_writing_skills_test_driven_development", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "writing-skills/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_writing_skills_skill", "target": "skills_writing_skills_writing_great_skills", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "writing-skills/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "tdd_for_skill_authoring_flow", "label": "TDD for Skill Authoring (RED-GREEN-REFAC