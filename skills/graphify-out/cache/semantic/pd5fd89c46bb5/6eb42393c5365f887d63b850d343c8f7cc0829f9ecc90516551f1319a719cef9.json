{"nodes": [{"id": "skills_skills_agents_adr_0001_explicit_setup_pointer_only_for_hard_dependencies_adr", "label": "ADR 0001: Explicit setup pointer only for hard dependencies", "file_type": "document", "source_file": "skills/.agents/adr/0001-explicit-setup-pointer-only-for-hard-dependencies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_agents_adr_0001_explicit_setup_pointer_only_for_hard_dependencies_setup_skill", "label": "setup-matt-pocock-skills (per-repo config seeder)", "file_type": "concept", "source_file": "skills/.agents/adr/0001-explicit-setup-pointer-only-for-hard-dependencies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seeds per-repo config (issue tracker, triage label vocabulary, domain doc layout) that engineering skills depend on; run once per repo before using the other engineering skills."}, {"id": "skills_skills_agents_adr_0001_explicit_setup_pointer_only_for_hard_dependencies_hardsoftdependency", "label": "Hard vs soft dependency split", "file_type": "rationale", "source_file": "skills/.agents/adr/0001-explicit-setup-pointer-only-for-hard-dependencies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hard dependencies (to-tickets, to-spec, triage) get an explicit run /setup-matt-pocock-skills pointer because without the mapping output is wrong; soft dependencies (diagnose, tdd, improve-codebase-architecture) degrade gracefully. The split keeps soft skills token-light and avoids cargo-culting the setup pointer where it isn't load-bearing."}], "edges": [{"source": "skills_skills_agents_adr_0001_explicit_setup_pointer_only_for_hard_dependencies_adr", "target": "skills_skills_agents_adr_0001_explicit_setup_pointer_only_for_hard_dependencies_hardsoftdependency", "relation": "conceptually_related_to", "confidence": "EXTRACT