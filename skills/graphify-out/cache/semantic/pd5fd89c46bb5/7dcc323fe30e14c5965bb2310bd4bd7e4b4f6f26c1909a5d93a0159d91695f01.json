{"nodes": [{"id": "skills_skills_skills_engineering_wayfinder_skill_wayfinder", "label": "Wayfinder", "file_type": "concept", "source_file": "skills/skills/engineering/wayfinder/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Planning by default - the map is done when the way is clear; the pull to just do the work is usually the signal you've reached the edge of the map; refer to tickets by name, never bare ids."}, {"id": "skills_skills_skills_engineering_wayfinder_skill_map", "label": "Wayfinding Map", "file_type": "concept", "source_file": "skills/skills/engineering/wayfinder/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The map is an index, not a store - a decision lives in exactly one place (its ticket) so the map only gists and links; a single issue labelled wayfinder:map whose tickets are child issues."}, {"id": "skills_skills_skills_engineering_wayfinder_skill_decision_ticket", "label": "Decision Ticket", "file_type": "concept", "source_file": "skills/skills/engineering/wayfinder/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Questions whose resolution is a decision, not slices of a build to execute; sized to one 100K token agent session; claims via assignment before any work."}, {"id": "skills_skills_skills_engineering_wayfinder_skill_fog_of_war", "label": "Fog of War", "file_type": "concept", "source_file": "skills/skills/engineering/wayfinder/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Don't chart what you can't yet see - the map is deliberately incomplete; the 'Not yet specified' section graduates into tickets as the frontier advances; the test is whether you can state the question precisely now, not answer it."}, {"id": "skills_skills_skills_engineering_wayfinder_skill_frontier", "label": "Frontier", "file_type": "concept", "source_file": "skills/skills/engineering/wayfinder/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The open, unblocked, unclaimed children of the map - the edge of the known; blocking uses the tracker's native dependency relationship so the frontier renders visually."}, {"id": "skills_skills_skills_engineering_wayfinder_skill_hitl", "label": "Human In The Loop", "file_type": "concept", "source_file": "skills/skills/engineering/wayfinder/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A HITL ticket only resolves through a live exchange with a human who speaks for themselves - the agent never stands in for the human's side of it."}, {"id": "skills_skills_skills_engineering_wayfinder_skill_research", "label": "Research (Skill)", "file_type": "concept", "source_file": "skills/skills/engineering/wayfinder/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AFK ticket type: reading docs, third-party APIs, or knowledge bases to surface a fact a decision waits on; resolved by a /research subagent, fired in parallel."}, {"id": "skills_skills_skills_engineering_wayfinder_skill_prototype", "label": "Prototype (Skill)", "file_type": "concept", "source_file": "skills/skills/engineering/wayfinder/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HITL ticket type: raise the fidelity of the discussion with a cheap, rough, concrete artifact to react to; links the prototype as an asset."}], "edges": [{"source": "skills_skills_skills_engineering_wayfinder_skill_wayfinder", "target": "skills_skills_skills_engineering_wayfinder_skill_map", "relation": "references", "confidence": "EXTRAC