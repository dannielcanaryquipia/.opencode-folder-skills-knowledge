{"nodes": [{"id": "skills_skills_skills_in_progress_writing_shape_skill", "label": "writing-shape", "file_type": "concept", "source_file": "skills/skills/in-progress/writing-shape/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_skills_in_progress_writing_shape_skill_exploit", "label": "exploit", "file_type": "rationale", "source_file": "skills/skills/in-progress/writing-shape/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The exploring is done, the pile is fixed \u2014 commit to a structure and mine the pile to fill it. The pile is a quarry, not a script: fragments may be split, merged, or paraphrased so the article reads as one voice."}, {"id": "skills_skills_skills_in_progress_writing_shape_skill_grounding", "label": "grounding", "file_type": "rationale", "source_file": "skills/skills/in-progress/writing-shape/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A concept gets grounded as a prerequisite (before the opening, fixed at the start) or introduced (a block establishes it). The lever is what you make a prerequisite versus what you ground inside: demand too much up front shuts readers out; ground too much inside and the opening drowns in definitions."}, {"id": "skills_skills_skills_in_progress_writing_shape_skill_shaping_loop", "label": "shaping loop", "file_type": "concept", "source_file": "skills/skills/in-progress/writing-shape/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_skills_in_progress_writing_shape_skill_pile_quarry", "label": "pulling from the pile", "file_type": "concept", "source_file": "skills/skills/in-progress/writing-shape/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_skills_in_progress_writing_shape_skill_format_arguments", "label": "format arguments", "file_type": "concept", "source_file": "skills/skills/in-progress/writing-shape/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weigh format tradeoffs out loud with the user, not silently: prose vs list (parallel items \u2192 list), inline vs callout (only if it genuinely derails the argument), table vs repeated structure (3+ repeats of same shape \u2192 table), quote vs paraphrase, code block vs inline code."}], "edges": [{"source": "skills_skills_skills_in_progress_writing_shape_skill", "target": "skills_skills_skills_in_progress_writing_shape_skill_exploit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/writing-shape/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_writing_shape_skill", "target": "skills_skills_skills_in_progress_writing_shape_skill_grounding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/writing-shape/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_writing_shape_skill", "target": "skills_skills_skills_in_progress_writing_shape_skill_shaping_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/writing-shape/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_writing_shape_skill", "target": "skills_skills_skills_in_progress_writing_shape_skill_pile_quarry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/writing-shape/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_writing_shape_skill", "target": "skills_skills_skills_in_progress_writing_shape_skill_format_arguments", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/writing-shape/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": []}