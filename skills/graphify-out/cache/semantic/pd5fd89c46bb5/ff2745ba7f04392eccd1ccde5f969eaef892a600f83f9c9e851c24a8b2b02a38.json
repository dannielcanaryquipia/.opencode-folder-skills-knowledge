{"nodes": [{"id": "skills_ponytail_skill", "label": "ponytail", "file_type": "concept", "source_file": "ponytail/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_ponytail_skill_the_ladder", "label": "The Ladder", "file_type": "rationale", "source_file": "ponytail/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stop at the first rung that holds (YAGNI, codebase reuse, stdlib, native platform, installed dep, one line, minimum code); laziness shortens the solution, never the reading of the problem."}, {"id": "skills_ponytail_skill_yagni", "label": "YAGNI", "file_type": "rationale", "source_file": "ponytail/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Speculative need should be skipped: the best code is the code never written, and abstractions without a second user or config nobody sets are deleted, not scaffolded."}, {"id": "skills_ponytail_skill_ponytail_comment_convention", "label": "ponytail: Comment Convention", "file_type": "rationale", "source_file": "ponytail/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberate simplifications are marked with a ponytail: comment naming the ceiling and upgrade path so a shortcut reads as intent rather than ignorance and can be revisited."}, {"id": "skills_ponytail_skill_intensity_levels", "label": "Intensity Levels", "file_type": "concept", "source_file": "ponytail/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "skills_ponytail_skill", "target": "skills_ponytail_skill_the_ladder", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ponytail/SKILL.md", "source_loca