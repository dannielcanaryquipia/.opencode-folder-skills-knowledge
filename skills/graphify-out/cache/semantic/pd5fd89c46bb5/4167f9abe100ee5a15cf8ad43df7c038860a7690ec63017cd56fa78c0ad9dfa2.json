{"nodes": [{"id": "skills_skills_agents_adr_0002_ship_as_a_claude_code_plugin_adr", "label": "ADR 0002: Ship as Claude Code plugin", "file_type": "document", "source_file": "skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_agents_adr_0002_ship_as_a_claude_code_plugin_claudeplugin", "label": "Claude Code plugin distribution", "file_type": "rationale", "source_file": "skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "plugin.json accepts an explicit array of skill paths, so the promoted set can be listed one by one with zero ambiguity; marketplace.json makes the repo its own single-plugin marketplace; version stays synced with package.json because Claude uses plugin version to decide when updates appear."}, {"id": "skills_skills_agents_adr_0002_ship_as_a_claude_code_plugin_codexplugin_deferred", "label": "Codex plugin (deferred)", "file_type": "rationale", "source_file": "skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Codex's manifest accepts skills only as a single path string and drops symlinks on install, so a curated promoted-only path needs either restructuring skills/ or committing duplicate copies - both structural decisions deferred until Codex supports arrays or preserves symlinks; skills.sh remains the universal installer for Codex today."}, {"id": "skills_skills_agents_adr_0002_ship_as_a_claude_code_plugin_promotedset", "label": "Promoted skill set", "file_type": "concept", "source_file": "skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only engineering/ and productivity/ skills ship; misc/, personal/, in-progress/, and deprecated/ are deliberately never promoted, which is what forces the curated plugin selection."}], "edges": [{"source": "skills_skills_agents_adr_0002_ship_as_a_claude_code_plugin_adr", "target": "skills_skills_agents_adr_0002_ship_as_a_claude_code_plugin_claudeplugin", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_agents_adr_0002_ship_as_a_claude_code_plugin_adr", "target": "skills_skills_agents_adr_0002_ship_as_a_claude_code_plugin_codexplugin_deferred", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_agents_adr_0002_ship_as_a_claude_code_plugin_claudeplugin", "target": "skills_skills_agents_adr_0002_ship_as_a_claude_code_plugin_codexplugin_deferred", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_agents_adr_0002_ship_as_a_claude_code_plugin_claudeplugin", "target": "skills_skills_agents_adr_0002_ship_as_a_claude_code_plugin_promotedset", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_agents_adr_0002_ship_as_a_claude_code_plugin_adr", "target": "skills_skills_claude_skillbuckets", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/.agents/adr/0002-ship-as-a-claude-code-plugin.md", "source_location": null, "w