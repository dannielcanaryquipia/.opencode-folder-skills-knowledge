{"nodes": [{"id": "skills_skills_skills_in_progress_wizard_skill", "label": "wizard", "file_type": "concept", "source_file": "skills/skills/in-progress/wizard/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_skills_in_progress_wizard_skill_bash_wizard", "label": "bash wizard", "file_type": "concept", "source_file": "skills/skills/in-progress/wizard/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bash script that walks a human through a manual procedure tedious to do by hand and tedious to re-explain to an AI every time \u2014 opens URLs, captures values, writes .env and GitHub secrets, confirms at every stage. Ephemeral by default; commit only when the user wants a repeatable setup path."}, {"id": "skills_skills_skills_in_progress_wizard_skill_template_sh", "label": "template.sh", "file_type": "concept", "source_file": "skills/skills/in-progress/wizard/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The delightful UX is already solved by template.sh (progress with time-remaining, confirmation gates, cross-platform URL opening, hidden secret entry, idempotent .env upserts, gh secret/variable writes, closing summary). The library above the STAGES marker is identical in every wizard \u2014 consistency is the point, never hand-edit it."}, {"id": "skills_skills_skills_in_progress_wizard_skill_stages", "label": "stages", "file_type": "concept", "source_file": "skills/skills/in-progress/wizard/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "skills_skills_skills_in_progress_wizard_skill", "target": "skills_skills_skills_in_progress_wizard_skill_bash_wizard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sour