{"nodes": [{"id": "skills_skills_skills_in_progress_writing_fragments_skill", "label": "writing-fragments", "file_type": "concept", "source_file": "skills/skills/in-progress/writing-fragments/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_skills_in_progress_writing_fragments_skill_fragment", "label": "fragment", "file_type": "concept", "source_file": "skills/skills/in-progress/writing-fragments/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any piece of text that might survive into the final article; it must be readable by the author but need not be comprehensible to a cold reader. Fragments are deliberately heterogeneous and separated by horizontal rules."}, {"id": "skills_skills_skills_in_progress_writing_fragments_skill_leading_word", "label": "leading word", "file_type": "concept", "source_file": "skills/skills/in-progress/writing-fragments/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A compact metaphor or coinage the whole piece can hang on \u2014 the most valuable fragment to land; name the right one in explore and it shapes structure, transitions, and title through the entire exploit phase."}, {"id": "skills_skills_skills_in_progress_writing_fragments_skill_explore", "label": "explore", "file_type": "rationale", "source_file": "skills/skills/in-progress/writing-fragments/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure explore widens the space of what could be written without committing to structure \u2014 committing is exploit, a separate skill's job; imposing phases, outlines, or article structure is out of scope here."}, {"id": "skills_skills_skills_in_progress_writing_fragments_skill_novelists_diary", "label": "novelist's diary", "file_type": "rationale", "source_file": "skills/skills/in-progress/writing-fragments/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The model for fragments: years of unstructured noticings that later get mined for raw material \u2014 fragments are noticings."}], "edges": [{"source": "skills_skills_skills_in_progress_writing_fragments_skill", "target": "skills_skills_skills_in_progress_writing_fragments_skill_fragment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/writing-fragments/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_writing_fragments_skill", "target": "skills_skills_skills_in_progress_writing_fragments_skill_leading_word", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/writing-fragments/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_writing_fragments_skill", "target": "skills_skills_skills_in_progress_writing_fragments_skill_explore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/writing-fragments/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_writing_fragments_skill_fragment", "target": "skills_skills_skills_in_progress_writing_fragments_skill_leading_word", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/writing-fragments/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_writing_fragments_skill_fragment", "target": "skills_skills_skills_in_progress_writing_fragments_skill_novelists_diary", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score