{"nodes": [{"id": "skills_skills_readme_readme", "label": "README.md", "file_type": "document", "source_file": "skills/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_skills_readme_installation", "label": "Installation paths (plugin vs skills.sh)", "file_type": "rationale", "source_file": "skills/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two philosophies: the Claude Code plugin subscribes to a managed read-only bundle; skills.sh copies editable files you own. Pick one - installing both leaves you with every skill twice."}, {"id": "skills_skills_readme_grilling", "label": "Grilling session", "file_type": "rationale", "source_file": "skills/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The fix for failure mode #1 (the agent didn't do what I want): getting the agent to ask detailed questions before building closes the communication gap between you and the agent."}, {"id": "skills_skills_readme_sharedlanguage", "label": "Shared language", "file_type": "rationale", "source_file": "skills/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The fix for failure mode #2 (the agent is way too verbose): a CONTEXT.md document decoding project jargon; with consistent naming, codebases become easier to navigate and the agent spends fewer tokens thinking."}, {"id": "skills_skills_readme_feedbackloop", "label": "Feedback loops", "file_type": "rationale", "source_file": "skills/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The fix for failure mode #3 (the code doesn't work): static types, browser access, and a red-green-refactor test loop so the agent is never flying blind; implemented as the /tdd and /diagnosing-bugs skills."}, {"id": "skills_skills_readme_deepmodules", "label": "Deep module design", "file_type": "rationale", "source_file": "skills/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The fix for failure mode #4 (we built a ball of mud): agents accelerate software entropy, so caring about code design is built into every layer; /to-spec quizzes module scope and /improve-codebase-architecture rescues messy codebases."}], "edges": [{"source": "skills_skills_readme_readme", "target": "skills_skills_agents_adr_0002_ship_as_a_claude_code_plugin_adr", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/README.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_readme_readme", "target": "skills_skills_readme_grilling", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/README.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_readme_readme", "target": "skills_skills_readme_sharedlanguage", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/README.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_readme_readme", "target": "skills_skills_readme_installation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/README.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_readme_readme", "target": "skills_skills_readme_feedbackloop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/README.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_readme_readme", "target": "skills_skills_readme_deepmodules", "relation": "conceptually_related_to", "confidence": "EXTRACTED"