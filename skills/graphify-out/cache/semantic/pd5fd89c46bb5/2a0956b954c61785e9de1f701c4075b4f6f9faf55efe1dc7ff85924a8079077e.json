{"nodes": [{"id": "skills_skills_skills_in_progress_loop_me_skill_loop_me", "label": "Loop Me", "file_type": "concept", "source_file": "skills/skills/in-progress/loop-me/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stateful /grilling session whose only output is workflow specs; mandate nothing structural - no AI, checkpoint, or schedule unless grilling shows it."}, {"id": "skills_skills_skills_in_progress_loop_me_skill_loop", "label": "Loop", "file_type": "concept", "source_file": "skills/skills/in-progress/loop-me/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A recurring pattern in the user's life (career, week, morning, a single repeated activity); picturing life as loops within loops reveals how predictable activities are - which is what makes them worth delegating."}, {"id": "skills_skills_skills_in_progress_loop_me_skill_workflow", "label": "Workflow", "file_type": "concept", "source_file": "skills/skills/in-progress/loop-me/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The spec of one loop, made real - you run a workflow on a loop, the loop is its running instantiation; workflows live in workflows/*.md and are the source of truth; done when an implementer agent could build it without asking a single question."}, {"id": "skills_skills_skills_in_progress_loop_me_skill_trigger", "label": "Trigger", "file_type": "concept", "source_file": "skills/skills/in-progress/loop-me/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What fires each run: an event (a new email, a new issue) or a schedule (every morning); event-triggering is usually the more efficient."}, {"id": "skills_skills_skills_in_progress_loop_me_skill_checkpoint", "label": "Checkpoint", "file_type": "concept", "source_file": "skills/skills/in-progress/loop-me/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A human-in-the-loop point where the user is asked to verify or decide; some workflows have none and run autonomously, some use no AI at all."}, {"id": "skills_skills_skills_in_progress_loop_me_skill_push_right", "label": "Push Right", "file_type": "concept", "source_file": "skills/skills/in-progress/loop-me/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defer the checkpoint as far as it will go - do maximal work before involving the human so they are asked once, late, with everything prepared; speed of review is imperative."}, {"id": "skills_skills_skills_in_progress_loop_me_skill_brief", "label": "Brief", "file_type": "concept", "source_file": "skills/skills/in-progress/loop-me/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What a checkpoint presents: a tight, decision-ready summary - what was produced, why, and a link down to the asset itself, never the raw output; the user reads a brief, not a draft."}], "edges": [{"source": "skills_skills_skills_in_progress_loop_me_skill_loop_me", "target": "skills_skills_skills_in_progress_loop_me_skill_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/loop-me/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_loop_me_skill_loop_me", "target": "skills_skills_skills_in_progress_loop_me_skill_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/skills/in-progress/loop-me/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_skills_skills_in_progress_loop_me_skill_loop_me", 